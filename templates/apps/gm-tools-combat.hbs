<section class="tab gm-tools-combat {{tab.cssClass}}" data-group="primary" data-tab="combat">
  {{#if hasCombat}}
  <div class="gm-section-head">
    <h3><i class="fa-solid fa-khanda"></i> {{localize "ELARIA.GMTools.combatRound" n=round}}</h3>
    <label data-tooltip="ELARIA.GMTools.amountHint">{{localize "ELARIA.GMTools.amount"}}
      <input type="number" name="combatAmount" value="{{combatAmount}}" min="1" step="1"></label>
  </div>
  <div class="combat-grid">
    {{#each units}}
    <div class="combat-unit {{#if pc}}pc{{else}}npc{{/if}} {{#if isCurrent}}current{{/if}} {{#if acted}}acted{{/if}} {{#if defeated}}defeated{{/if}} {{#if hidden}}is-hidden{{/if}}" data-combatant="{{id}}">
      <header>
        <img src="{{img}}" alt="" data-action="unitPan" data-tooltip="ELARIA.GMTools.panHint">
        <div class="who">
          <a class="name" data-action="unitSheet">{{name}}</a>
          <span class="sub">{{localize "ELARIA.GMTools.init"}} {{initiative}}{{#if level}} · {{levelLabel}} {{level}}{{/if}}{{#if pc}} · {{localize "ELARIA.GMTools.pc"}}{{/if}}{{#if acted}} · <i class="fa-solid fa-check"></i> {{localize "ELARIA.Turn.acted"}}{{/if}}</span>
        </div>
        <a class="toggle {{#if hidden}}on{{/if}}" data-action="unitHidden" data-tooltip="{{#if hidden}}ELARIA.GMTools.hiddenOn{{else}}ELARIA.GMTools.hiddenOff{{/if}}">
          <i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></a>
        <a class="toggle {{#if defeated}}on dead{{/if}}" data-action="unitDefeated" data-tooltip="{{#if defeated}}ELARIA.GMTools.defeatedOn{{else}}ELARIA.GMTools.defeatedOff{{/if}}">
          <i class="fa-solid fa-skull"></i></a>
      </header>
      <div class="unit-resources">
        {{#each resources}}
        <div class="unit-res {{key}}">
          <span class="res-label">{{label}}</span>
          <a class="step" data-action="unitResource" data-res="{{key}}" data-dir="down"><i class="fa-solid fa-minus"></i></a>
          <input type="number" data-res="{{key}}" value="{{value}}" min="0" step="1">
          <span class="of">/ {{max}}{{#if temp}} <small>+{{temp}}</small>{{/if}}</span>
          <a class="step" data-action="unitResource" data-res="{{key}}" data-dir="up"><i class="fa-solid fa-plus"></i></a>
          <div class="bar"><div class="fill" style="width: {{pct}}%"></div></div>
        </div>
        {{/each}}
      </div>
      {{#if conditions}}<div class="unit-conditions">{{conditions}}</div>{{/if}}
      <div class="unit-row">
        <span class="row-label">{{localize "ELARIA.GMTools.reactions"}}</span>
        <span class="unit-pips">{{#each pips}}<a class="pip {{state}}" data-action="unitPip" data-index="{{index}}"></a>{{/each}}</span>
      </div>
      <div class="unit-row effects">
        <span class="row-label">{{localize "ELARIA.GMTools.statuses"}}</span>
        <span class="unit-effects">
          {{#each effects}}<img src="{{img}}" alt="" data-action="unitRemoveEffect" data-effect="{{id}}" data-statuses="{{statuses}}"
            data-tooltip="{{name}} ({{localize 'ELARIA.GMTools.clickRemove'}})">{{/each}}
        </span>
        <select name="addStatus" data-tooltip="ELARIA.GMTools.addStatusHint">
          <option value="">+</option>
          {{#each ../statusChoices}}<option value="{{id}}">{{name}}</option>{{/each}}
        </select>
      </div>
    </div>
    {{else}}
    <p class="empty-players">{{localize "ELARIA.GMTools.noCombatants"}}</p>
    {{/each}}
  </div>
  {{else}}
  <p class="empty-players">{{localize "ELARIA.GMTools.noCombat"}}</p>
  {{/if}}
</section>
