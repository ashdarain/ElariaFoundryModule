<section class="tab monster-notes {{tab.cssClass}}" data-group="primary" data-tab="notes">
  <fieldset class="m-prose">
    <legend>{{localize "ELARIA.Monster.description"}}
      {{#if isGM}}<span class="dc">{{localize "ELARIA.Monster.dc"}} {{system.natureDC.overview}}</span>{{/if}}</legend>
    <prose-mirror name="system.details.description" value="{{system.details.description}}" toggled
      {{#unless editable}}disabled{{/unless}}>{{{descriptionHTML}}}</prose-mirror>
  </fieldset>
  <div class="m-loot">
    <fieldset class="m-prose">
      <legend>{{localize "ELARIA.Monster.uniqueLoot"}}
        {{#if isGM}}<span class="dc">{{localize "ELARIA.Monster.dc"}} {{system.natureDC.loot}}</span>{{/if}}</legend>
      <prose-mirror name="system.loot.unique" value="{{system.loot.unique}}" toggled
        {{#unless editable}}disabled{{/unless}}>{{{uniqueLootHTML}}}</prose-mirror>
    </fieldset>
    <fieldset class="m-prose">
      <legend>{{localize "ELARIA.Monster.lootTables"}}</legend>
      <prose-mirror name="system.loot.tables" value="{{system.loot.tables}}" toggled
        {{#unless editable}}disabled{{/unless}}>{{{lootTablesHTML}}}</prose-mirror>
    </fieldset>
  </div>
</section>
