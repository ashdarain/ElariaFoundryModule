<section class="tab monster-stats {{tab.cssClass}}" data-group="primary" data-tab="stats">
  <div class="section-head">
    <h3>{{localize "ELARIA.Monster.stats"}}</h3>
    {{#if isGM}}<span class="dc">{{localize "ELARIA.Monster.dc"}} {{system.natureDC.stats}}</span>{{/if}}
    <span class="hint">{{localize "ELARIA.Monster.statsHint"}}</span>
  </div>
  <div class="m-stat-groups">
    {{#each statGroups}}
    <div class="m-stat-group">
      <h4>{{localize label}}</h4>
      {{#each stats}}
      <div class="m-stat-row">
        <a class="stat-roll" data-action="rollStat" data-stat="{{key}}" data-tooltip="ELARIA.Stats.rollName">{{localize label}}</a>
        <input type="number" name="system.stats.{{key}}.mod" value="{{mod}}" step="1" data-tooltip="ELARIA.Monster.modHint">
        <a class="roll-mod" data-action="rollStat" data-stat="{{key}}" data-tooltip="ELARIA.Stats.rollName"><i class="fa-solid fa-dice"></i></a>
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>

  <div class="m-defence-grid">
    <fieldset>
      <legend>{{localize "ELARIA.Monster.defence"}}</legend>
      {{#each defenceRows}}
      <label class="m-field"><span>{{label}}</span><input type="number" name="system.defence.{{key}}" value="{{value}}" step="1"></label>
      {{/each}}
    </fieldset>
    <fieldset>
      <legend>{{localize "ELARIA.Monster.combat"}}</legend>
      {{#each combatRows}}
      <label class="m-field"><span>{{label}}</span><input type="number" name="system.combat.{{key}}" value="{{value}}" step="1"></label>
      {{/each}}
    </fieldset>
  </div>

  <section class="resistances m-resistances">
    <div class="resist-head">
      <h4>{{localize "ELARIA.Resist.title"}} <small>{{localize "ELARIA.Resist.hint"}}</small></h4>
      <div class="form-toggle" data-tooltip="ELARIA.Monster.formHint">
        {{#each formChoices}}
        <label class="{{key}} {{#if checked}}active{{/if}}"><input type="radio" name="system.details.form" value="{{key}}" {{checked checked}}> {{label}}</label>
        {{/each}}
      </div>
    </div>
    <h5>{{localize "ELARIA.Resist.forms"}} <small>{{localize "ELARIA.Monster.formsHint"}}</small></h5>
    <div class="resist-grid forms">
      {{#each resistForms}}{{> resistCell this}}{{/each}}
    </div>
    <h5>{{localize "ELARIA.Resist.elements"}} <small>{{#if elementNames}}{{localize "ELARIA.Monster.elementsFrom" names=elementNames}}{{else}}{{localize "ELARIA.Monster.noElements"}}{{/if}}</small></h5>
    <div class="resist-grid">
      {{#each resistElements}}{{> resistCell this}}{{/each}}
    </div>
    {{#if system.defence.elementalRes}}
    <label class="m-field wide old-res"><span>{{localize "ELARIA.Monster.elementalResOld"}}</span>
      <input type="text" name="system.defence.elementalRes" value="{{system.defence.elementalRes}}"></label>
    {{/if}}
  </section>
</section>
